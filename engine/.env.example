# --- data (required) ---
HELIUS_API_KEY=
# HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=...   (optional, derived from the key)

# --- AI analysis (optional: without a key the deterministic scorer runs alone) ---
ANTHROPIC_API_KEY=
# VERA_MODEL=claude-opus-5-5
# VERA_AI_BAND=15          # max points the AI may move the base score
# VERA_AI=off              # force-disable

# --- signing ---
# VERA_SIGNER_SECRET=      # base58 ed25519 seed; if unset, .keys/signer.json is created on first run
# VERA_TTL_HOURS=24

# --- on-chain anchoring of attestation hashes (Memo program): off | devnet | mainnet ---
# The signer address must hold SOL (~0.000005 SOL per check).
VERA_ANCHOR=off

# --- API ---
PORT=8790
# VERA_API_KEYS=key1,key2  # keyed callers skip the anonymous rate limit
# VERA_ANON_PER_MIN=10
# VERA_CACHE_MIN=10

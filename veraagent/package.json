{
  "name": "veralayer",
  "version": "0.2.0",
  "description": "Payment guard for AI agents on Solana: inspects every outgoing transaction, scores each recipient with Vera, and enforces your spending policy before anything is signed.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./agent-kit": {
      "types": "./dist/agent-kit.d.ts",
      "import": "./dist/agent-kit.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "veralayer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/cli.js",
    "./dist/mcp.js"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --env-file-if-exists=../../../../checker/.env test/run.mjs && node --env-file-if-exists=../../../../checker/.env test/security.mjs",
    "prepublishOnly": "tsc && node test/smoke.mjs"
  },
  "keywords": [
    "solana",
    "ai-agent",
    "agent-payments",
    "trust-score",
    "risk",
    "guard",
    "mcp",
    "solana-agent-kit",
    "model-context-protocol",
    "claude",
    "cursor"
  ],
  "homepage": "https://veraagent.io",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0",
    "zod": ">=3.22"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veraagent/vera.git",
    "directory": "veraagent"
  },
  "bugs": {
    "url": "https://github.com/veraagent/vera/issues"
  }
}
